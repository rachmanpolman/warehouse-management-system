generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabel Master Barang
model Product {
  id        String          @id @default(uuid())
  sku       String          @unique
  name      String
  barcode   String          @unique
  stock     Int             @default(0)
  minStock  Int             @default(5)
  maxStock  Int             @default(100) // Batas atas, di atas ini = overstock
  leadTimeDays Int      @default(7)   // Berapa hari vendor butuh waktu mengirim barang
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  movements StockMovement[]
  purchaseRequests PurchaseRequest[]
}

// Tabel Riwayat Pengurangan / Penambahan Stok
model StockMovement {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String   // "OUT" atau "IN"
  quantity  Int
  notes     String?
  createdAt DateTime @default(now())
}

// Tabel Notifikasi per Divisi (warehouse, purchasing, incoming, outgoing)
model Notification {
  id         String   @id @default(uuid())
  targetRole String   // "warehouse" | "purchasing" | "incoming" | "outgoing"
  type       String   // "INFO" | "WARNING" | "CRITICAL" | "SUCCESS"
  title      String
  message    String
  productId  String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Tabel Alur Pengadaan (Warehouse -> Purchasing -> Vendor -> Incoming)
model PurchaseRequest {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  quantity         Int      // Jumlah unit yang diminta Warehouse
  receivedQuantity Int?     // Jumlah fisik yang diterima Incoming nanti
  vendorName       String?  // Nama vendor/supplier yang dibayar Purchasing
  status           String   @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | PAID | RECEIVED
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}